formulas:
  City: if(file.hasTag("apoch") || file.inFolder("Apoch"), "Apoch", if(file.hasTag("rign") || file.inFolder("Rign"), "Rign", if(file.hasTag("sci") || file.inFolder("Sci"), "Sci",if(file.hasTag("inbetween") || file.inFolder("The Fourth City") || file.inFolder("In Between"), "Between"))))
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Masterlist/Game Notes")
    order:
      - file.basename
      - formula.City
      - file.tags
      - file.path
    sort:
      - property: file.basename
        direction: ASC
      - property: file.tags
        direction: ASC
  - type: table
    name: View
    order:
      - file.name
      - file.tags
      - formula.City
      - file.folder
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.folder: 59
      formula.City: 133
